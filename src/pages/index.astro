---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form method="get" class="mb-8 rounded-2xl border border-slate-700 bg-slate-800 p-5 shadow-lg" data-testid="game-filters">
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-100">Filter games</h2>
          <p class="text-sm text-slate-300">Narrow your catalog by category, publisher, or both.</p>
        </div>

        <a
          href="/"
          class="hidden inline-flex items-center rounded-md border border-slate-600 bg-slate-700 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
          data-testid="clear-filters-link"
        >
          Clear filters
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <fieldset class="space-y-3" data-testid="category-filter-group">
          <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>

          {categories.length > 0 ? (
            categories.map((category) => (
              <label
                class="flex items-center gap-3 rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-slate-200 transition-colors hover:bg-slate-700"
                data-testid={`category-filter-label-${category.id}`}
              >
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-0 focus:ring-offset-slate-800"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))
          ) : (
            <p class="text-sm text-slate-400">No categories available.</p>
          )}
        </fieldset>

        <fieldset class="space-y-3" data-testid="publisher-filter-group">
          <legend class="mb-2 text-sm font-medium text-slate-200">Publishers</legend>

          {publishers.length > 0 ? (
            publishers.map((publisher) => (
              <label
                class="flex items-center gap-3 rounded-lg border border-slate-700 bg-slate-900/60 px-3 py-2 text-slate-200 transition-colors hover:bg-slate-700"
                data-testid={`publisher-filter-label-${publisher.id}`}
              >
                <input
                  type="checkbox"
                  name="publisher"
                  value={publisher.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-0 focus:ring-offset-slate-800"
                  data-testid={`publisher-filter-${publisher.id}`}
                />
                <span>{publisher.name}</span>
              </label>
            ))
          ) : (
            <p class="text-sm text-slate-400">No publishers available.</p>
          )}
        </fieldset>
      </div>

      <div class="mt-5 flex justify-end">
        <button
          type="submit"
          class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
          data-testid="apply-filters-button"
        >
          Apply filters
        </button>
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div hidden={games.length > 0} data-testid="empty-state">
        <EmptyState text="No games available at the moment." />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid" hidden={games.length === 0}>
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>

  <script>
    const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const clearFiltersLink = document.querySelector<HTMLAnchorElement>('[data-testid="clear-filters-link"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
    const emptyStateText = emptyState?.querySelector<HTMLElement>('[data-testid="empty-state-text"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="publisher"]'));

    /**
     * Reads the checked filter values for a form field.
     *
     * @param name - The filter input name.
     * @returns The selected filter IDs.
     */
    function getSelectedValues(name: string): string[] {
      return Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((input) => input.value);
    }

    /** Updates game visibility and empty-state messaging from the active filters. */
    function applyFilters() {
      const selectedCategories = getSelectedValues('category');
      const selectedPublishers = getSelectedValues('publisher');
      const hasActiveFilters = selectedCategories.length > 0 || selectedPublishers.length > 0;
      let visibleGameCount = 0;

      gameCards.forEach((card) => {
        const categoryIds = (card.getAttribute('data-game-category-id') ?? '').split(',').filter(Boolean);
        const publisherIds = (card.getAttribute('data-game-publisher-id') ?? '').split(',').filter(Boolean);
        const matchesCategory = selectedCategories.length === 0 || categoryIds.some((id) => selectedCategories.includes(id));
        const matchesPublisher = selectedPublishers.length === 0 || publisherIds.some((id) => selectedPublishers.includes(id));
        const isVisible = matchesCategory && matchesPublisher;
        card.hidden = !isVisible;

        if (isVisible) {
          visibleGameCount += 1;
        }
      });

      if (gamesGrid) {
        gamesGrid.hidden = visibleGameCount === 0;
      }

      if (emptyState) {
        emptyState.hidden = visibleGameCount !== 0;
      }

      if (emptyStateText) {
        emptyStateText.textContent = hasActiveFilters ? 'No games match the selected filters.' : 'No games available at the moment.';
      }

      if (clearFiltersLink) {
        clearFiltersLink.classList.toggle('hidden', !hasActiveFilters);
      }
    }

    if (filterForm) {
      filterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters();
      });
    }

    categoryInputs.concat(publisherInputs).forEach((input) => {
      input.addEventListener('change', applyFilters);
    });

    if (clearFiltersLink) {
      clearFiltersLink.addEventListener('click', (event) => {
        event.preventDefault();
        categoryInputs.forEach((input) => {
          input.checked = false;
        });
        publisherInputs.forEach((input) => {
          input.checked = false;
        });
        applyFilters();
      });
    }

    applyFilters();
  </script>
</Layout>
